# Copy to .env and fill in. Never commit .env.

# --- Database (local: docker compose MySQL; cloud: Huawei Cloud RDS for MySQL) ---
DATABASE_URL=mysql+pymysql://taniguard:taniguard@mysql:3306/taniguard?charset=utf8mb4

# --- Cache (local: docker compose Redis; cloud: Huawei Cloud DCS for Redis) ---
REDIS_URL=redis://redis:6379/0

# --- Object storage: "local" (disk) or "obs" (Huawei Cloud OBS, S3-compatible) ---
STORAGE_BACKEND=local
OBS_ENDPOINT=https://obs.ap-southeast-3.myhuaweicloud.com
OBS_BUCKET=
OBS_ACCESS_KEY=
OBS_SECRET_KEY=

# --- Inference: "local" (PyTorch in-process) or "remote" (Huawei Cloud ModelArts endpoint) ---
PREDICTOR=local
MODELARTS_ENDPOINT=
MODELARTS_TOKEN=

# --- Assistant LLM (optional; e.g. Huawei Cloud Pangu). Leave blank to use rule-based answers. ---
LLM_ENDPOINT=
LLM_API_KEY=
LLM_MODEL=

# --- Scheduled jobs (weather fetch every 3 h) ---
ENABLE_SCHEDULER=true
