# Copy to .env and fill in. Never commit .env.

# --- Local MySQL container (docker compose). Change these passwords. ---
MYSQL_DATABASE=taniguard
MYSQL_USER=taniguard
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

# --- Database override (cloud: Huawei Cloud RDS for MySQL). Leave unset locally; compose builds it from MYSQL_*. ---
# DATABASE_URL=mysql+pymysql://USER:PASSWORD@RDS_HOST:3306/taniguard?charset=utf8mb4

# --- Cache (local: docker compose Redis; cloud: Huawei Cloud DCS for Redis) ---
REDIS_URL=redis://redis:6379/0

# --- Comma-separated origins allowed to call the API cross-origin (empty = same-origin only) ---
CORS_ORIGINS=

# --- Object storage: "local" (disk) or "obs" (Huawei Cloud OBS, S3-compatible) ---
STORAGE_BACKEND=local
OBS_ENDPOINT=https://obs.ap-southeast-3.myhuaweicloud.com
OBS_BUCKET=
OBS_ACCESS_KEY=
OBS_SECRET_KEY=
# Optional; derived from OBS_ENDPOINT when blank (obs.<region>.myhuaweicloud.com).
OBS_REGION=

# --- Inference: "local" (PyTorch in-process) or "remote" (Huawei Cloud ModelArts endpoint) ---
PREDICTOR=local
MODELARTS_ENDPOINT=
MODELARTS_TOKEN=

# --- Assistant LLM (optional; e.g. Huawei Cloud Pangu). Leave blank to use rule-based answers. ---
LLM_ENDPOINT=
LLM_API_KEY=
LLM_MODEL=

# --- Scheduled jobs (weather fetch every 3 h) ---
ENABLE_SCHEDULER=true
# Advance "Simulated device" sensors every 15 min (needs ENABLE_SCHEDULER=true). Set false once real devices report.
ENABLE_DEVICE_SIM=true

# --- Login (Phase 6). SECRET_KEY signs session cookies; if unset, a random key is generated in data/.secret_key. ---
SECRET_KEY=
# Set to true when served over HTTPS (Huawei Cloud ELB/ECS with a certificate).
SESSION_COOKIE_SECURE=false
# Optional demo accounts created by `flask seed-base` (usernames "farmer" and "expert"). Leave blank to skip.
DEMO_FARMER_PASSWORD=
DEMO_EXPERT_PASSWORD=
